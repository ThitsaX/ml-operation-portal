                <mxCell id="scheme" value="&lt;b&gt;Scheme level&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#5A6F91&#39;&gt;Global feature gate&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Enables or disables NDC threshold processing&lt;br&gt;• Controls whether scheduled NDC jobs may run&lt;br&gt;• Top-level gate for the notification feature" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F0E7FF;strokeColor=#7738E8;strokeWidth=2;fontColor=#172746;fontSize=14;spacing=14;align=left;verticalAlign=top;" parent="1" vertex="1">
